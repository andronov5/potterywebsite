# Public project identifiers (safe to include in browser bundles).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Private server values. Set in your host's environment settings, never in Git.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_RATE_ID=
# The exact HTTPS origin, with no trailing path; for example https://your-domain.com
SITE_URL=
# Explicit launch gate. Leave false until the setup and test purchase pass.
CHECKOUT_ENABLED=false
# Enable after Netlify detects pottery-contact and its email notification is set.
CONTACT_EMAIL_ENABLED=false
# Choose and verify your Stripe tax configuration before enabling checkout.
STRIPE_AUTOMATIC_TAX=false
